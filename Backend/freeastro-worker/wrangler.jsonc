{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zodiac-daily-content",
  "main": "src/index.js",
  "compatibility_date": "2026-08-09",
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "DAILY_CACHE",
      "id": "REPLACE_WITH_CLOUDFLARE_KV_NAMESPACE_ID"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "WARMUP_QUEUE",
        "queue": "zodiac-daily-warmup"
      }
    ],
    "consumers": [
      {
        "queue": "zodiac-daily-warmup",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 1,
        "max_concurrency": 1,
        "retry_delay": 300
      }
    ]
  },
  "triggers": {
    "crons": ["15 0 * * *", "45 9 * * *"]
  }
}
